# Copy to .env and fill in. Never commit .env.

# Deye Cloud (developer.deyecloud.com, app with Station + Device Monitoring only)
DEYE_BASE_URL=https://eu1-developer.deyecloud.com
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_EMAIL=
# echo -n 'yourDeyeCloudPassword' | sha256sum
DEYE_PASSWORD_SHA256=
# deviceSn of the INVERTER from /v1.0/station/listWithDevice
DEYE_INVERTER_SN=

# Clients must send header  X-API-Key: <API_KEY>
# generate: openssl rand -hex 24
API_KEY=

POLL_SECONDS=300
STALE_SECONDS=900

# Port on the Pi (8080 is often taken, e.g. by qBittorrent)
HOST_PORT=8090
